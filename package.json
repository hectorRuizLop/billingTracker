{
  "name": "billing-tracker",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/audit-logging": "^1",
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0.4.1",
