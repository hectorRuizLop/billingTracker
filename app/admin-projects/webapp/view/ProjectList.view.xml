<mvc:View
  controllerName="nubexx.billing.admin.projects.controller.ProjectList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Page id="projectListPage" title="{i18n>Projects}" showNavButton="false">
    <content>
      <Table
        id="projectTable"
        items="{path:'/Projects', parameters:{$count:true}}"
        mode="SingleSelectMaster"
        selectionChange=".onSelectionChange"
        growing="true"
        growingScrollToLoad="true">
        <headerToolbar>
          <Toolbar>
            <Title text="{i18n>Projects}"/>
            <ToolbarSpacer/>
            <SearchField search=".onSearch" width="30%"/>
            <Button text="{i18n>Create}" press=".onCreate" type="Emphasized"/>
            <Button text="{i18n>Delete}" press=".onDelete" type="Reject"/>
          </Toolbar>
        </headerToolbar>
        <columns>
          <Column><Text text="{i18n>ProjectName}"/></Column>
          <Column><Text text="{i18n>Client}"/></Column>
          <Column><Text text="{i18n>Status}"/></Column>
          <Column><Text text="{i18n>Budget}"/></Column>
          <Column><Text text="{i18n>StartDate}"/></Column>
          <Column><Text text="{i18n>EndDate}"/></Column>
        </columns>
        <items>
          <ColumnListItem type="Navigation" press=".onPress">
            <cells>
              <Text text="{name}"/>
              <Text text="{clientName}"/>
              <Text text="{status}"/>
              <Text text="{budget}"/>
              <Text text="{startDate}"/>
              <Text text="{endDate}"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
  </Page>
</mvc:View>
