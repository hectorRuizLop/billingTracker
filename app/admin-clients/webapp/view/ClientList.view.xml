<mvc:View
  controllerName="nubexx.billing.admin.clients.controller.ClientList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Page id="clientListPage" title="{i18n>Clients}" showNavButton="false">
    <content>
      <Table
        id="clientTable"
        items="{path:'/Clients', parameters:{$count:true}}"
        mode="SingleSelectMaster"
        selectionChange=".onSelectionChange"
        growing="true"
        growingScrollToLoad="true">
        <headerToolbar>
          <Toolbar>
            <Title text="{i18n>Clients}"/>
            <ToolbarSpacer/>
            <SearchField search=".onSearch" width="30%"/>
            <Button text="{i18n>Create}" press=".onCreate" type="Emphasized"/>
            <Button text="{i18n>Delete}" press=".onDelete" type="Reject"/>
          </Toolbar>
        </headerToolbar>
        <columns>
          <Column><Text text="{i18n>ClientName}"/></Column>
          <Column><Text text="{i18n>Email}"/></Column>
          <Column><Text text="{i18n>Phone}"/></Column>
          <Column><Text text="{i18n>TaxId}"/></Column>
          <Column><Text text="{i18n>Deleted}"/></Column>
        </columns>
        <items>
          <ColumnListItem type="Navigation" press=".onPress">
            <cells>
              <Text text="{name}"/>
              <Text text="{email}"/>
              <Text text="{phone}"/>
              <Text text="{taxId}"/>
              <core:Icon src="{= ${isDeleted} ? 'sap-icon://decline' : 'sap-icon://accept'}" 
                         color="{= ${isDeleted} ? '#bb0000' : '#107e3e'}"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
  </Page>
</mvc:View>