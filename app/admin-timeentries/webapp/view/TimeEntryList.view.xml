<mvc:View
  controllerName="nubexx.billing.admin.timeentries.controller.TimeEntryList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Page id="timeEntryListPage" title="{i18n>TimeEntries}" showNavButton="false">
    <content>
      <Table
        id="timeEntryTable"
        items="{path:'/TimeEntries', parameters:{$count:true}}"
        mode="SingleSelectMaster"
        selectionChange=".onSelectionChange"
        growing="true"
        growingScrollToLoad="true">
        <headerToolbar>
          <Toolbar>
            <Title text="{i18n>TimeEntries}"/>
            <ToolbarSpacer/>
            <SearchField search=".onSearch" width="30%"/>
            <Button text="{i18n>Create}" press=".onCreate" type="Emphasized"/>
            <Button text="{i18n>Delete}" press=".onDelete" type="Reject"/>
          </Toolbar>
        </headerToolbar>
        <columns>
          <Column><Text text="{i18n>Date}"/></Column>
          <Column><Text text="{i18n>Project}"/></Column>
          <Column><Text text="{i18n>Employee}"/></Column>
          <Column><Text text="{i18n>Hours}"/></Column>
          <Column><Text text="{i18n>Status}"/></Column>
          <Column><Text text="{i18n>Cost}"/></Column>
        </columns>
        <items>
          <ColumnListItem type="Navigation" press=".onPress">
            <cells>
              <Text text="{date}"/>
              <Text text="{projectName}"/>
              <Text text="{employeeName}"/>
              <Text text="{hours}"/>
              <Text text="{status}"/>
              <Text text="{cost}"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
  </Page>
</mvc:View>
