{
  "_version": "1.60.0",
  "sap.app": {
    "id": "nubexx.billing.manager",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "ManagerService": {
        "uri": "/api/manager/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "manager-dashboard": {
          "semanticObject": "Projects",
          "action": "manage",
          "title": "{{appTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.f": {},
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.uxap": {},
        "sap.suite.ui.microchart": {},
        "sap.viz": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css",
          "id": "managerStyle"
        }
      ]
    },
    "rootView": {
      "viewName": "nubexx.billing.manager.view.App",
      "type": "XML",
      "async": true,
      "id": "appRootView"
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      },
      "": {
        "dataSource": "ManagerService",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.f.routing.Router",
        "viewType": "XML",
        "viewPath": "nubexx.billing.manager.view",
        "controlId": "appFCL",
        "controlAggregation": "beginColumnPages",
        "transition": "slide",
        "async": true
      },
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ProjectsList",
          "target": ["ProjectsList"]
        },
        {
          "pattern": "Projects({key}):?query:",
          "name": "ProjectDetail",
          "target": ["ProjectsList", "ProjectDetail"]
        },
        {
          "pattern": "TimeEntries:?query:",
          "name": "TimeEntriesList",
          "target": ["TimeEntriesList"]
        },
        {
          "pattern": "TimeEntries({key}):?query:",
          "name": "TimeEntryDetail",
          "target": ["TimeEntriesList", "TimeEntryDetail"]
        }
      ],
      "targets": {
        "ProjectsList": {
          "viewName": "ProjectsList",
          "viewId": "ProjectsList",
          "controlAggregation": "beginColumnPages"
        },
        "ProjectDetail": {
          "viewName": "ProjectDetail",
          "viewId": "ProjectDetail",
          "controlAggregation": "midColumnPages"
        },
        "TimeEntriesList": {
          "viewName": "TimeEntriesList",
          "viewId": "TimeEntriesList",
          "controlAggregation": "beginColumnPages"
        },
        "TimeEntryDetail": {
          "viewName": "TimeEntryDetail",
          "viewId": "TimeEntryDetail",
          "controlAggregation": "midColumnPages"
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}