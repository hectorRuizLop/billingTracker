<mvc:View
  controllerName="nubexx.billing.manager.controller.ProjectsList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Page id="projectsListPage" title="{i18n>Projects}" showNavButton="false">
    <content>
      <Table
        id="projectsTable"
        items="{path:'/Projects', parameters:{$count:true}}"
        mode="SingleSelectMaster"
        selectionChange=".onSelectionChange"
        growing="true"
        growingScrollToLoad="true">
        <headerToolbar>
          <Toolbar>
            <Title text="{i18n>Projects}"/>
            <ToolbarSpacer/>
            <SearchField id="searchField" search=".onSearch" width="25%"/>
            <Select id="statusFilter" change=".onFilterChange" autoAdjustWidth="true">
              <core:Item key="" text="{i18n>AllStatus}"/>
              <core:Item key="O" text="{i18n>Open}"/>
              <core:Item key="C" text="{i18n>Closed}"/>
            </Select>
            <Button text="{i18n>Create}" press=".onCreate" type="Emphasized"/>
          </Toolbar>
        </headerToolbar>
        <columns>
          <Column><Text text="{i18n>Project}"/></Column>
          <Column width="6rem"><Text text="{i18n>Status}"/></Column>
          <Column width="8rem"><Text text="{i18n>Budget}"/></Column>
          <Column width="8rem"><Text text="{i18n>ApprovedHours}"/></Column>
          <Column width="8rem"><Text text="{i18n>ApprovedCost}"/></Column>
          <Column width="12rem"><Text text="{i18n>BudgetRemaining}"/></Column>
        </columns>
        <items>
          <ColumnListItem type="Navigation" press=".onPress">
            <cells>
              <ObjectIdentifier title="{name}" text="{clientName}" wrapping="false" class="managerProjectIdentifier"/>
              <ObjectStatus text="{= ${status} === 'O' ? ${i18n>Open} : ${i18n>Closed}}" 
                           state="{= ${status} === 'O' ? 'Information' : 'Success'}"/>
              <ObjectNumber number="{budget}"
                           unit="EUR"
                           state="{= ${budgetCriticality} === 1 ? 'Error' : (${budgetCriticality} === 2 ? 'Warning' : 'Success')}"/>
              <ObjectNumber number="{totalHours}"
                           unit="h"/>
              <ObjectNumber number="{totalCost}"
                           unit="EUR"
                           state="{= ${budgetCriticality} === 1 ? 'Error' : (${budgetCriticality} === 2 ? 'Warning' : 'Success')}"/>
              <ProgressIndicator
                percentValue="{= ${budget} > 0 ? parseFloat(((${budget} - ${budgetRemaining}) / ${budget} * 100).toFixed(0)) : 0}"
                displayValue="{budgetRemaining} EUR"
                state="{= ${budgetCriticality} === 1 ? 'Error' : (${budgetCriticality} === 2 ? 'Warning' : 'Success')}"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
  </Page>
</mvc:View>
