<mvc:View
  controllerName="nubexx.billing.employee.controller.MyTimeEntriesList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.f"
  xmlns:microchart="sap.suite.ui.microchart">

  <f:DynamicPage id="timeEntriesDynamicPage" headerExpanded="true">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading>
          <Title text="{i18n>MyTimeEntries}" />
        </f:heading>
        <f:actions>
          <Button id="notificationBell" icon="sap-icon://bell" press=".onOpenNotifications" type="Transparent">
            <customData>
              <core:CustomData key="badge" value="0" writeToDom="true"/>
            </customData>
          </Button>
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>

    <f:header>
      <f:DynamicPageHeader pinnable="true">
        <f:content>
          <HBox justifyContent="SpaceBetween" alignItems="Center">
            <HBox>
              <VBox class="sapUiMediumMarginEnd" alignItems="Center">
                <NumericContent
                  icon="sap-icon://time-entry-request"
                  value="{kpiModel>/totalEntries}"
                  valueColor="Good"
                  withMargin="false" />
                <Text text="Entries" class="sapUiTinyMarginTop" />
              </VBox>
              <VBox class="sapUiMediumMarginEnd" alignItems="Center">
                <NumericContent
                  icon="sap-icon://measure"
                  value="{kpiModel>/totalHours}"
                  valueColor="Information"
                  withMargin="false" />
                <Text text="Hours" class="sapUiTinyMarginTop" />
              </VBox>
              <VBox class="sapUiMediumMarginEnd" alignItems="Center">
                <NumericContent
                  icon="sap-icon://accept"
                  value="{kpiModel>/approvedHours}"
                  valueColor="Success"
                  withMargin="false" />
                <Text text="Approved" class="sapUiTinyMarginTop" />
              </VBox>
              <VBox alignItems="Center">
                <NumericContent
                  icon="sap-icon://pending"
                  value="{kpiModel>/draftCount}"
                  valueColor="Critical"
                  withMargin="false" />
                <Text text="Drafts" class="sapUiTinyMarginTop" />
              </VBox>
            </HBox>
          </HBox>
        </f:content>
      </f:DynamicPageHeader>
    </f:header>

    <f:content>
      <IconTabBar id="iconTabBar" select=".onTabSelect" selectedKey="timeEntries">
        <items>
          <IconTabFilter key="timeEntries" text="{i18n>MyTimeEntries}">
            <VBox>
              <!-- Period Chart -->
              <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginTop sapUiTinyMarginBegin">
                <Title text="{periodModel>/title}" titleStyle="H5"/>
                <SegmentedButton selectedKey="{periodModel>/key}" selectionChange=".onPeriodChange">
                  <items>
                    <SegmentedButtonItem key="week" text="Week"/>
                    <SegmentedButtonItem key="month" text="Month"/>
                    <SegmentedButtonItem key="year" text="Year"/>
                  </items>
                </SegmentedButton>
              </HBox>
              <microchart:ColumnMicroChart
                id="weekChart"
                width="100%"
                height="120px"
                columns="{weekModel>/columns}">
                <microchart:columns>
                  <microchart:ColumnMicroChartData
                    label="{weekModel>label}"
                    value="{weekModel>value}"
                    color="{weekModel>color}"/>
                </microchart:columns>
              </microchart:ColumnMicroChart>

              <!-- Status Filter Tabs -->
              <IconTabBar
                id="statusIconTabBar"
                select=".onStatusIconTabSelect"
                selectedKey="all"
                expandable="false"
                class="sapUiSmallMarginTop">
                <items>
                  <IconTabFilter key="all" text="All" count="{statusCountModel>/all}"/>
                  <IconTabFilter key="D" text="Draft" count="{statusCountModel>/draft}"/>
                  <IconTabFilter key="S" text="Submitted" count="{statusCountModel>/submitted}"/>
                  <IconTabFilter key="A" text="Approved" count="{statusCountModel>/approved}"/>
                  <IconTabFilter key="R" text="Rejected" count="{statusCountModel>/rejected}" iconColor="Negative"/>
                </items>
              </IconTabBar>

              <Table
                id="timeEntriesTable"
                items="{path:'/MyTimeEntries', parameters:{$count:true}}"
                mode="SingleSelectMaster"
                selectionChange=".onSelectionChange"
                growing="true"
                growingScrollToLoad="true">
                <headerToolbar>
                  <Toolbar>
                    <Title text="{i18n>MyTimeEntries}"/>
                    <ToolbarSpacer/>
                    <SearchField id="searchField" search=".onSearch" liveChange=".onSearch" width="20%" placeholder="Search projects..."/>
                    <DateRangeSelection id="dateRangeFilter" change=".onDateRangeFilterChange" placeholder="Date range" width="20%" valueFormat="yyyy-MM-dd" displayFormat="medium"/>
                    <Button text="{i18n>submitMonth}" press=".onSubmitMonth" type="Emphasized"/>
                  </Toolbar>
                </headerToolbar>
                <columns>
                  <Column width="30%"><Text text="{i18n>Date}"/></Column>
                  <Column><Text text="{i18n>Project}"/></Column>
                  <Column width="8rem" hAlign="Center"><Text text="{i18n>Hours}"/></Column>
                  <Column width="10rem" hAlign="Center"><Text text="{i18n>Status}"/></Column>
                  <Column width="3rem"><Text text=""/></Column>
                </columns>
                <items>
                  <ColumnListItem type="Navigation" press=".onPress">
                    <cells>
                      <HBox alignItems="Center">
                        <Avatar
                          initials="{parts:[{path:'date'}], formatter:'.formatDateInitials'}"
                          displaySize="S"
                          class="sapUiSmallMarginEnd" />
                        <ObjectIdentifier
                          title="{date}"
                          text="{description}" />
                      </HBox>
                      <Text text="{projectName}" />
                      <ObjectNumber number="{hours}" unit="h" />
                      <ObjectStatus
                        text="{statusText}"
                        state="{= ${status} === 'D' ? 'None' : ${status} === 'S' ? 'Information' : ${status} === 'A' ? 'Success' : 'Error'}"
                        inverted="true" />
                      <Button
                        icon="sap-icon://alert"
                        visible="false"
                        press=".onShowRejectionNote"
                        type="Transparent"/>
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </VBox>
          </IconTabFilter>

          <IconTabFilter key="projectSummary" text="{i18n>MyProjectSummary}">
            <VBox>
              <Title text="Time Distribution" titleStyle="H5" class="sapUiSmallMarginTop sapUiTinyMarginBegin"/>
              <microchart:InteractiveDonutChart
                id="projectDonutChart"
                selectionChanged=".onDonutSegmentSelect"
                segments="{/MyProjectSummary}">
                <microchart:segments>
                  <microchart:InteractiveDonutChartSegment
                    label="{projectName}"
                    value="{totalHours}"
                    displayedValue="{totalHours}h"/>
                </microchart:segments>
              </microchart:InteractiveDonutChart>

              <Table
                id="projectSummaryTable"
                items="{path:'/MyProjectSummary', parameters:{$count:true}}"
                growing="true"
                growingScrollToLoad="true">
                <headerToolbar>
                  <Toolbar>
                    <Title text="{i18n>MyProjectSummary}"/>
                  </Toolbar>
                </headerToolbar>
                <columns>
                  <Column width="30%"><Text text="{i18n>Project}"/></Column>
                  <Column width="10rem" hAlign="Center"><Text text="{i18n>Hours}"/></Column>
                  <Column width="10rem" hAlign="Center"><Text text="{i18n>entryCount}"/></Column>
                </columns>
                <items>
                  <ColumnListItem>
                    <cells>
                      <HBox alignItems="Center">
                        <Avatar
                          initials="{parts:[{path:'projectName'}], formatter:'.formatProjectInitials'}"
                          displaySize="S"
                          class="sapUiSmallMarginEnd" />
                        <ObjectIdentifier title="{projectName}" />
                      </HBox>
                      <ObjectNumber number="{totalHours}" unit="h" />
                      <ObjectStatus text="{entryCount}" inverted="true" />
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </VBox>
          </IconTabFilter>

          <IconTabFilter key="monthlySummary" text="{i18n>MyMonthlySummary}">
            <Table
              id="monthlySummaryTable"
              items="{path:'/MyMonthlySummary', parameters:{$count:true}}"
              growing="true"
              growingScrollToLoad="true">
              <headerToolbar>
                <Toolbar>
                  <Title text="{i18n>MyMonthlySummary}"/>
                </Toolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>year}"/></Column>
                <Column><Text text="{i18n>month}"/></Column>
                <Column width="10rem" hAlign="Center"><Text text="{i18n>Hours}"/></Column>
                <Column width="10rem" hAlign="Center"><Text text="{i18n>entryCount}"/></Column>
                <Column width="12rem"><Text text="Progress"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Text text="{year}"/>
                    <Text text="{month}"/>
                    <ObjectNumber number="{totalHours}" unit="h" />
                    <ObjectStatus text="{entryCount}" inverted="true" state="Information" />
                    <ProgressIndicator
                      displayValue="{totalHours}h"
                      percentValue="{= (${totalHours} / 160) * 100 }"
                      state="{path:'totalHours', formatter:'.formatProgressState'}"
                      showValue="true"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>
        </items>
      </IconTabBar>
    </f:content>
  </f:DynamicPage>
</mvc:View>
