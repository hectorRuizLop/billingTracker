<mvc:View
  controllerName="nubexx.billing.employee.controller.MyTimeEntriesList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:microchart="sap.suite.ui.microchart">
  <Page id="timeEntriesListPage" title="{i18n>MyTimeEntries}" showNavButton="false">
    <content>
      <IconTabBar id="iconTabBar" select=".onTabSelect" selectedKey="timeEntries">
        <items>
          <IconTabFilter key="timeEntries" text="{i18n>MyTimeEntries}">
            <VBox>
              <!-- Period Chart -->
              <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginTop sapUiTinyMarginBegin">
                <Title text="{periodModel>/title}" titleStyle="H5"/>
                <SegmentedButton selectedKey="{periodModel>/key}" selectionChange=".onPeriodChange">
                  <items>
                    <SegmentedButtonItem key="week" text="Week"/>
                    <SegmentedButtonItem key="month" text="Month"/>
                    <SegmentedButtonItem key="year" text="Year"/>
                  </items>
                </SegmentedButton>
              </HBox>
              <microchart:ColumnMicroChart
                id="weekChart"
                width="100%"
                height="120px"
                columns="{weekModel>/columns}">
                <microchart:columns>
                  <microchart:ColumnMicroChartData
                    label="{weekModel>label}"
                    value="{weekModel>value}"
                    color="{weekModel>color}"/>
                </microchart:columns>
              </microchart:ColumnMicroChart>

              <!-- Status Filter Tabs -->
              <IconTabBar
                id="statusIconTabBar"
                select=".onStatusIconTabSelect"
                selectedKey="all"
                expandable="false"
                class="sapUiSmallMarginTop">
                <items>
                  <IconTabFilter key="all" text="All" count="{statusCountModel>/all}"/>
                  <IconTabFilter key="D" text="Draft" count="{statusCountModel>/draft}"/>
                  <IconTabFilter key="S" text="Submitted" count="{statusCountModel>/submitted}"/>
                  <IconTabFilter key="A" text="Approved" count="{statusCountModel>/approved}"/>
                  <IconTabFilter key="R" text="Rejected" count="{statusCountModel>/rejected}" iconColor="Negative"/>
                </items>
              </IconTabBar>

              <Table
                id="timeEntriesTable"
                items="{path:'/MyTimeEntries', parameters:{$count:true}}"
                mode="SingleSelectMaster"
                selectionChange=".onSelectionChange"
                growing="true"
                growingScrollToLoad="true">
                <headerToolbar>
                  <Toolbar>
                    <Title text="{i18n>MyTimeEntries}"/>
                    <ToolbarSpacer/>
                    <SearchField id="searchField" search=".onSearch" width="20%"/>
                    <DateRangeSelection id="dateRangeFilter" change=".onDateRangeFilterChange" placeholder="Date range" width="20%" valueFormat="yyyy-MM-dd" displayFormat="medium"/>
                    <Button text="{i18n>submitMonth}" press=".onSubmitMonth" type="Emphasized"/>
                  </Toolbar>
                </headerToolbar>
                <columns>
                  <Column><Text text="{i18n>Date}"/></Column>
                  <Column><Text text="{i18n>Project}"/></Column>
                  <Column><Text text="{i18n>Hours}"/></Column>
                  <Column><Text text="{i18n>Status}"/></Column>
                  <Column width="3rem"><Text text=""/></Column>
                </columns>
                <items>
                  <ColumnListItem type="Navigation" press=".onPress">
                    <cells>
                      <Text text="{date}"/>
                      <ObjectIdentifier title="{projectName}" text="{description}"/>
                      <Text text="{hours}"/>
                      <ObjectStatus
                        text="{statusText}"
                        state="{= ${status} === 'D' ? 'None' : ${status} === 'S' ? 'Information' : ${status} === 'A' ? 'Success' : 'Error'}"/>
                      <Button
                        icon="sap-icon://alert"
                        visible="false"
                        press=".onShowRejectionNote"
                        type="Transparent"/>
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </VBox>
          </IconTabFilter>

          <IconTabFilter key="projectSummary" text="{i18n>MyProjectSummary}">
            <VBox>
              <Title text="Time Distribution" titleStyle="H5" class="sapUiSmallMarginTop sapUiTinyMarginBegin"/>
              <microchart:InteractiveDonutChart
                id="projectDonutChart"
                selectionChanged=".onDonutSegmentSelect"
                segments="{/MyProjectSummary}">
                <microchart:segments>
                  <microchart:InteractiveDonutChartSegment
                    label="{projectName}"
                    value="{totalHours}"
                    displayedValue="{totalHours}h"/>
                </microchart:segments>
              </microchart:InteractiveDonutChart>

              <Table
                id="projectSummaryTable"
                items="{path:'/MyProjectSummary', parameters:{$count:true}}"
                growing="true"
                growingScrollToLoad="true">
                <headerToolbar>
                  <Toolbar>
                    <Title text="{i18n>MyProjectSummary}"/>
                  </Toolbar>
                </headerToolbar>
                <columns>
                  <Column><Text text="{i18n>Project}"/></Column>
                  <Column><Text text="{i18n>Hours}"/></Column>
                  <Column><Text text="{i18n>entryCount}"/></Column>
                </columns>
                <items>
                  <ColumnListItem>
                    <cells>
                      <Text text="{projectName}"/>
                      <Text text="{totalHours}"/>
                      <Text text="{entryCount}"/>
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </VBox>
          </IconTabFilter>

          <IconTabFilter key="monthlySummary" text="{i18n>MyMonthlySummary}">
            <Table
              id="monthlySummaryTable"
              items="{path:'/MyMonthlySummary', parameters:{$count:true}}"
              growing="true"
              growingScrollToLoad="true">
              <headerToolbar>
                <Toolbar>
                  <Title text="{i18n>MyMonthlySummary}"/>
                </Toolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>year}"/></Column>
                <Column><Text text="{i18n>month}"/></Column>
                <Column><Text text="{i18n>Hours}"/></Column>
                <Column><Text text="{i18n>entryCount}"/></Column>
                <Column><Text text="Progress"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Text text="{year}"/>
                    <Text text="{month}"/>
                    <Text text="{totalHours}"/>
                    <Text text="{entryCount}"/>
                    <ProgressIndicator
                      displayValue="{totalHours}h"
                      percentValue="{= (${totalHours} / 160) * 100 }"
                      state="{path:'totalHours', formatter:'.formatProgressState'}"
                      showValue="true"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>
        </items>
      </IconTabBar>
    </content>
  </Page>
</mvc:View>
