<mvc:View
  controllerName="nubexx.billing.employee.controller.MyCalendar"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:u="sap.ui.unified"
  xmlns:f="sap.f"
  xmlns:card="sap.f.cards">

  <f:DynamicPage id="calendarDynamicPage" headerExpanded="false">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading>
          <Title text="{i18n>MyCalendar}" />
        </f:heading>
        <f:navigationActions>
          <Button text="{i18n>TimeEntries}" icon="sap-icon://list" press=".onGoToList" type="Transparent" />
        </f:navigationActions>
      </f:DynamicPageTitle>
    </f:title>

    <f:content>
      <f:Card class="sapUiMediumMargin">
        <f:header>
          <card:Header title="Monthly Overview" iconSrc="sap-icon://calendar" />
        </f:header>
        <f:content>
          <VBox class="sapUiSmallMargin">
            <!-- Month / Year selector -->
            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
              <Label text="{i18n>Month}" class="sapUiSmallMarginEnd" />
              <Select
                id="monthSelect"
                change=".onMonthYearChange"
                items="{path: '/months', templateShareable: false}">
                <items>
                  <core:Item xmlns:core="sap.ui.core" key="{key}" text="{text}" />
                </items>
              </Select>
              <Label text="{i18n>Year}" class="sapUiSmallMarginBegin sapUiSmallMarginEnd" />
              <Select
                id="yearSelect"
                change=".onMonthYearChange"
                items="{path: '/years', templateShareable: false}">
                <items>
                  <core:Item xmlns:core="sap.ui.core" key="{key}" text="{text}" />
                </items>
              </Select>
            </HBox>

            <!-- Calendar -->
            <u:Calendar
              id="hoursCalendar"
              select=".onDateSelect"
              class="sapUiMediumMarginBottom" />

            <!-- Legend -->
            <HBox justifyContent="SpaceBetween" class="sapUiSmallMarginTop">
              <HBox alignItems="Center">
                <u:CalendarLegendItem type="Type01" text="{i18n>HasHours}" />
              </HBox>
              <HBox alignItems="Center">
                <u:CalendarLegendItem type="Type03" text="{i18n>NoHours}" />
              </HBox>
              <HBox alignItems="Center">
                <u:CalendarLegendItem type="None" text="{i18n>Weekend}" />
              </HBox>
            </HBox>
          </VBox>
        </f:content>
      </f:Card>
    </f:content>
  </f:DynamicPage>
</mvc:View>
