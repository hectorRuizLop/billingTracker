<mvc:View
  controllerName="nubexx.billing.employee.controller.MyTimeEntriesDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:form="sap.ui.layout.form"
  xmlns:uxap="sap.uxap"
  xmlns:f="sap.f"
  xmlns:card="sap.f.cards">

  <uxap:ObjectPageLayout id="detailObjectPage" height="100%" showTitleInHeaderContent="false">
    <uxap:headerTitle>
      <uxap:ObjectPageDynamicHeaderTitle>
        <uxap:expandedHeading>
          <HBox alignItems="Center">
            <Avatar
              initials="{parts:[{path:'projectName'}], formatter:'.formatProjectInitials'}"
              displaySize="L"
              class="sapUiMediumMarginEnd" />
            <VBox>
              <Title text="{date} — {projectName}" titleStyle="H3" />
              <Text text="ID: {ID}" class="sapUiTinyMarginTop" />
            </VBox>
          </HBox>
        </uxap:expandedHeading>
        <uxap:snappedHeading>
          <HBox alignItems="Center">
            <Avatar
              initials="{parts:[{path:'projectName'}], formatter:'.formatProjectInitials'}"
              displaySize="M"
              class="sapUiSmallMarginEnd" />
            <Title text="{date} — {projectName}" titleStyle="H4" />
          </HBox>
        </uxap:snappedHeading>
      </uxap:ObjectPageDynamicHeaderTitle>
    </uxap:headerTitle>

    <uxap:headerContent>
      <ObjectStatus
        text="{statusText}"
        state="{= ${status} === 'D' ? 'None' : ${status} === 'S' ? 'Information' : ${status} === 'A' ? 'Success' : 'Error'}" />
      <ObjectNumber
        number="{= ${hours} &amp;&amp; ${rateSnapshot} ? parseFloat(${hours}) * parseFloat(${rateSnapshot}) : '' }"
        unit="EUR"
        emphasized="true"
        state="Success"/>
    </uxap:headerContent>

    <uxap:sections>
      <uxap:ObjectPageSection titleUppercase="false" title="{i18n>Details}">
        <uxap:ObjectPageSubSection>
          <f:Card class="sapUiMediumMargin">
            <f:header>
              <card:Header title="Entry Details" iconSrc="sap-icon://time-entry-request" />
            </f:header>
            <f:content>
              <VBox class="sapUiSmallMargin">
                <form:SimpleForm layout="ResponsiveGridLayout" columnsL="2" columnsM="1">
                  <form:content>
                    <Label text="{i18n>Date}" design="Bold"/>
                    <Text text="{date}"/>
                    <Label text="{i18n>Project}" design="Bold"/>
                    <Text text="{projectName}"/>
                    <Label text="{i18n>Hours}" design="Bold"/>
                    <ObjectNumber number="{hours}" unit="h" />
                    <Label text="{i18n>Description}" design="Bold"/>
                    <Text text="{description}"/>
                    <Label text="{i18n>rateSnapshot}" design="Bold"/>
                    <ObjectNumber number="{rateSnapshot}" unit="EUR/h" />
                    <Label text="{i18n>cost}" design="Bold"/>
                    <ObjectNumber
                      number="{= ${hours} &amp;&amp; ${rateSnapshot} ? parseFloat(${hours}) * parseFloat(${rateSnapshot}) : '' }"
                      unit="EUR"
                      state="Success"/>
                  </form:content>
                </form:SimpleForm>
              </VBox>
            </f:content>
          </f:Card>
        </uxap:ObjectPageSubSection>
      </uxap:ObjectPageSection>

      <uxap:ObjectPageSection titleUppercase="false" title="{i18n>ReviewInfo}">
        <uxap:ObjectPageSubSection>
          <f:Card class="sapUiMediumMargin">
            <f:header>
              <card:Header title="Review Status" iconSrc="sap-icon://manager" />
            </f:header>
            <f:content>
              <VBox class="sapUiSmallMargin">
                <form:SimpleForm layout="ResponsiveGridLayout" columnsL="2" columnsM="1">
                  <form:content>
                    <Label text="{i18n>Status}" design="Bold"/>
                    <ObjectStatus
                      text="{statusText}"
                      state="{= ${status} === 'D' ? 'None' : ${status} === 'S' ? 'Information' : ${status} === 'A' ? 'Success' : 'Error'}"
                      inverted="true" />
                    <Label text="{i18n>RejectionNote}" design="Bold"/>
                    <Text text="{rejectionNote}"/>
                    <Label text="{i18n>reviewedAt}" design="Bold"/>
                    <Text text="{reviewedAt}"/>
                  </form:content>
                </form:SimpleForm>
              </VBox>
            </f:content>
          </f:Card>
        </uxap:ObjectPageSubSection>
      </uxap:ObjectPageSection>

      <uxap:ObjectPageSection titleUppercase="false" title="Overtime" visible="{= ${isOvertime} === true }">
        <uxap:ObjectPageSubSection>
          <f:Card class="sapUiMediumMargin">
            <f:header>
              <card:Header title="Overtime Details" iconSrc="sap-icon://overtime" />
            </f:header>
            <f:content>
              <VBox class="sapUiSmallMargin">
                <form:SimpleForm layout="ResponsiveGridLayout" columnsL="2" columnsM="1">
                  <form:content>
                    <Label text="Overtime Hours" design="Bold"/>
                    <ObjectNumber number="{overtimeHours}" unit="h" state="Warning"/>
                    <Label text="Justification" design="Bold"/>
                    <Text text="{overtimeJustification}"/>
                  </form:content>
                </form:SimpleForm>
              </VBox>
            </f:content>
          </f:Card>
        </uxap:ObjectPageSubSection>
      </uxap:ObjectPageSection>
    </uxap:sections>
  </uxap:ObjectPageLayout>
</mvc:View>
