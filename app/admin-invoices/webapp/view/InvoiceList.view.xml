<mvc:View
  controllerName="nubexx.billing.admin.invoices.controller.InvoiceList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Page id="invoiceListPage" title="{i18n>Invoices}" showNavButton="false">
    <content>
      <Table
        id="invoiceTable"
        items="{path:'/Invoices', parameters:{$count:true}}"
        mode="SingleSelectMaster"
        selectionChange=".onSelectionChange"
        growing="true"
        growingScrollToLoad="true">
        <headerToolbar>
          <Toolbar>
            <Title text="{i18n>Invoices}"/>
            <ToolbarSpacer/>
            <SearchField search=".onSearch" width="30%"/>
            <Button text="{i18n>Create}" press=".onCreate" type="Emphasized"/>
            <Button text="{i18n>Delete}" press=".onDelete" type="Reject"/>
          </Toolbar>
        </headerToolbar>
        <columns>
          <Column><Text text="{i18n>InvoiceNumber}"/></Column>
          <Column><Text text="{i18n>IssueDate}"/></Column>
          <Column><Text text="{i18n>DueDate}"/></Column>
          <Column><Text text="{i18n>Status}"/></Column>
          <Column><Text text="{i18n>Total}"/></Column>
          <Column><Text text="{i18n>Client}"/></Column>
        </columns>
        <items>
          <ColumnListItem type="Navigation" press=".onPress">
            <cells>
              <Text text="{invoiceNumber}"/>
              <Text text="{issueDate}"/>
              <Text text="{dueDate}"/>
              <Text text="{status}"/>
              <Text text="{total}"/>
              <Text text="{clientName}"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
  </Page>
</mvc:View>
